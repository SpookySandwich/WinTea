#include <windows.h>
#include "resource.h"
#include "version.h"

// The app manifest (asInvoker + PerMonitorV2 DPI) is embedded by the linker via
// CMake (app.manifest is a target source), not here -- the MSVC linker's own
// manifest pipeline would otherwise override an RC-embedded RT_MANIFEST.

// Icons (generated into assets/icon by tools/make-icons.ps1).
IDI_APP            ICON "..\\..\\assets\\icon\\wintea.ico"
IDI_TRAY_FOR_LIGHT ICON "..\\..\\assets\\icon\\tray-for-light-taskbar.ico"
IDI_TRAY_FOR_DARK  ICON "..\\..\\assets\\icon\\tray-for-dark-taskbar.ico"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION    WINTEA_VERSION_MAJOR,WINTEA_VERSION_MINOR,WINTEA_VERSION_PATCH,0
    PRODUCTVERSION WINTEA_VERSION_MAJOR,WINTEA_VERSION_MINOR,WINTEA_VERSION_PATCH,0
    FILEFLAGSMASK  0x3fL
    FILEFLAGS      0x0L
    FILEOS         VOS_NT_WINDOWS32
    FILETYPE       VFT_APP
    FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "WinTea"
            VALUE "FileDescription",  "WinTea - Win+T terminal launcher"
            VALUE "FileVersion",      WINTEA_VERSION_STR
            VALUE "InternalName",     "WinTea"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "WinTea.exe"
            VALUE "ProductName",      "WinTea"
            VALUE "ProductVersion",   WINTEA_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
